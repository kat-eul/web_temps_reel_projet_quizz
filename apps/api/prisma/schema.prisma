generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id                Int               @id @default(autoincrement())
  pseudo            String            @unique
  email             String            @unique
  password          String
  role              UserRole          @default(USER)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  roomParticipations RoomParticipant[]
  chatMessages      ChatMessage[]
  ownedRooms        Room[]            @relation("RoomOwner")
}

model Quiz {
  id        Int        @id @default(autoincrement())
  title     String
  createur  String
  questions Question[]
  rooms     Room[]
}

model Room {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  nbMaxParticipants Int
  nbParticipants  Int               @default(0)
  quizId          Int
  quiz            Quiz              @relation(fields: [quizId], references: [id])
  ownerId         Int
  owner           User              @relation("RoomOwner", fields: [ownerId], references: [id])
  state           RoomState         @default(WAITING)
  currentQuestionId Int?
  currentQuestion Question?         @relation(fields: [currentQuestionId], references: [id])
  questionStartedAt DateTime?
  questionEndsAt  DateTime?
  participants    RoomParticipant[]
  chatMessages    ChatMessage[]
  createdAt       DateTime          @default(now())
}

enum RoomState {
  WAITING
  IN_PROGRESS
  FINISHED
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  roomId    Int
  senderId  Int
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

model RoomParticipant {
  roomId   Int
  userId   Int
  joinedAt DateTime @default(now())
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

model Question {
  id       Int      @id @default(autoincrement())
  question String
  quizId   Int
  quiz     Quiz     @relation(fields: [quizId], references: [id])
  answers  Answer[]
  rooms    Room[]
}

model Answer {
  id         Int      @id @default(autoincrement())
  enonce     String
  isTrue     Boolean
  questionId Int
  question   Question @relation(fields: [questionId], references: [id])
}